{
  "description": "Cases for scripts/src/run-test-cases.ts. Each case runs POST /api/analyze-yard, confirms the issues marked present (as the review screen pre-checks them), then runs POST /api/generate-plan. Expect rules: issue (key + status: present | absent | not-present), noIssuePresent, noWeekTitle (title), planExcludes (topics: seeding | weeds | shade).",
  "cases": [
    {
      "id": "typical",
      "name": "1. Typical",
      "input": {
        "zip": "46556",
        "grassType": "tall-fescue",
        "currentDescription": "Mostly green but thin in spots, some dandelions and clover, a couple bare patches near the driveway.",
        "desiredDescription": "Thick, even, dark green lawn with no weeds or bare spots."
      },
      "expect": [
        { "rule": "issue", "key": "bare", "status": "present" },
        { "rule": "issue", "key": "weeds", "status": "present" },
        { "rule": "issue", "key": "thin", "status": "present" },
        { "rule": "issue", "key": "shade", "status": "absent" }
      ]
    },
    {
      "id": "challenge",
      "name": "2. Challenge (vague)",
      "input": {
        "zip": "33101",
        "grassType": "not-sure",
        "currentDescription": "it's ok i guess.",
        "desiredDescription": "better."
      },
      "expect": [
        { "rule": "noIssuePresent" },
        { "rule": "noWeekTitle", "title": "Fix the trouble spots" }
      ]
    },
    {
      "id": "healthy",
      "name": "3. Healthy-lawn regression",
      "input": {
        "zip": "46556",
        "grassType": "tall-fescue",
        "currentDescription": "Healthy, thick lawn. No weeds, no bare patches, and no shade.",
        "desiredDescription": "Keep it looking this good."
      },
      "expect": [
        { "rule": "issue", "key": "bare", "status": "absent" },
        { "rule": "issue", "key": "weeds", "status": "absent" },
        { "rule": "issue", "key": "dry", "status": "absent" },
        { "rule": "issue", "key": "thin", "status": "absent" },
        { "rule": "issue", "key": "shade", "status": "absent" },
        { "rule": "planExcludes", "topics": ["seeding", "weeds", "shade"] }
      ]
    },
    {
      "id": "goal-only-wording",
      "name": "4. Goal-only wording",
      "input": {
        "zip": "30301",
        "grassType": "bermuda",
        "currentDescription": "Some brown, crispy areas by the sidewalk.",
        "desiredDescription": "Dark green and weed-free under the big oak tree."
      },
      "expect": [
        { "rule": "issue", "key": "dry", "status": "present" },
        { "rule": "issue", "key": "weeds", "status": "absent" },
        { "rule": "issue", "key": "shade", "status": "not-present" }
      ]
    }
  ]
}
